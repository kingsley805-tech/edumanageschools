datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum AppRole {
  super_admin
  admin
  teacher
  student
  parent
}

enum Gender {
  male
  female
  other
}

enum AttendanceStatus {
  present
  absent
  late
  excused
}

enum InvoiceStatus {
  draft
  pending
  partially_paid
  paid
  overdue
  cancelled
}

enum PaymentMethod {
  cash
  bank_transfer
  pos
  mobile_money
  stripe
  paystack
  cheque
}

enum SubscriptionStatus {
  trial
  active
  grace_period
  expired
  cancelled
}

enum ExamType {
  class_test
  mid_term
  end_of_term
  mock
  final
}

// -------------------------------------------------------------
// MULTI-TENANCY & SCHOOLS
// -------------------------------------------------------------

model School {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  code            String   @unique
  slug            String   @unique
  address         String?
  phone           String?
  email           String?
  logoUrl         String?  @map("logo_url")
  primaryColor    String?  @default("#1E40AF") @map("primary_color")
  secondaryColor  String?  @default("#F59E0B") @map("secondary_color")
  motto           String?
  currency        String   @default("GHS")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  profiles              Profile[]
  userRoles             UserRole[]
  classes               Class[]
  subjects              Subject[]
  academicYears         AcademicYear[]
  feeStructures         FeeStructure[]
  billingInvoices       BillingInvoice[]
  billingPayments       BillingPayment[]
  announcements         Announcement[]
  auditLogs             AuditLog[]
  gatewaySettings       PaymentGatewaySetting[]
  subscriptions         OrganizationSubscription[]
  students              Student[]
  teachers              Teacher[]
  parents               Parent[]
  classRegisters        ClassRegister[]
  exams                 Exam[]
  grades                Grade[]
  termReportCards       TermReportCard[]
  feeCategories         FeeCategory[]

  @@map("schools")
}

model SubscriptionPackage {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  code          String   @unique
  price         Decimal  @db.Decimal(12, 2)
  currency      String   @default("GHS")
  billingCycle  String   @default("termly") @map("billing_cycle")
  maxStudents   Int      @map("max_students")
  maxTeachers   Int      @map("max_teachers")
  features      Json     @default("[]")
  createdAt     DateTime @default(now()) @map("created_at")

  subscriptions OrganizationSubscription[]

  @@map("subscription_packages")
}

model OrganizationSubscription {
  id          String             @id @default(uuid()) @db.Uuid
  schoolId    String             @map("school_id") @db.Uuid
  packageId   String             @map("package_id") @db.Uuid
  status      SubscriptionStatus @default(trial)
  startDate   DateTime           @map("start_date")
  endDate     DateTime           @map("end_date")
  autoRenew   Boolean            @default(true) @map("auto_renew")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  school      School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  package     SubscriptionPackage @relation(fields: [packageId], references: [id])

  @@map("organization_subscriptions")
}

// -------------------------------------------------------------
// USERS, PROFILES & AUTHENTICATION
// -------------------------------------------------------------

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  passwordHash  String    @map("password_hash")
  phone         String?   @unique
  refreshToken  String?   @map("refresh_token")
  isVerified    Boolean   @default(false) @map("is_verified")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  profile       Profile?
  userRoles     UserRole[]

  @@map("users")
}

model Profile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  fullName    String   @map("full_name")
  firstName   String?  @map("first_name")
  lastName    String?  @map("last_name")
  avatarUrl   String?  @map("avatar_url")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student     Student?
  teacher     Teacher?
  parent      Parent?

  @@index([schoolId])
  @@map("profiles")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  role      AppRole  @default(student)
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([userId, schoolId, role])
  @@index([schoolId, role])
  @@map("user_roles")
}

model PasswordResetOtp {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  phone     String?
  otpHash   String   @map("otp_hash")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("password_reset_otps")
}

// -------------------------------------------------------------
// ACADEMICS & CLASSES
// -------------------------------------------------------------

model AcademicYear {
  id        String    @id @default(uuid()) @db.Uuid
  schoolId  String    @map("school_id") @db.Uuid
  name      String    // e.g. "2025/2026"
  startDate DateTime  @map("start_date")
  endDate   DateTime  @map("end_date")
  term      String    // e.g. "Term 1", "Semester 1"
  isCurrent Boolean   @default(false) @map("is_current")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes   Class[]
  registers ClassRegister[]
  exams     Exam[]
  feeStructures FeeStructure[]
  invoices  BillingInvoice[]
  reportCards TermReportCard[]

  @@unique([schoolId, name, term])
  @@map("academic_years")
}

model Class {
  id              String   @id @default(uuid()) @db.Uuid
  schoolId        String   @map("school_id") @db.Uuid
  academicYearId  String?  @map("academic_year_id") @db.Uuid
  name            String   // e.g. "Basic 7A", "Grade 10 - Science"
  stage           String?  // e.g. "Primary", "JHS", "SHS"
  level           Int?
  stream          String?  // e.g. "A", "B", "Gold"
  capacity        Int      @default(40)
  classTeacherId  String?  @map("class_teacher_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  school          School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear    AcademicYear? @relation(fields: [academicYearId], references: [id])
  classTeacher    Teacher?      @relation("ClassTeacher", fields: [classTeacherId], references: [id])
  students        Student[]
  classSubjects   ClassSubject[]
  registers       ClassRegister[]
  feeStructures   FeeStructure[]
  reportCards     TermReportCard[]

  @@index([schoolId])
  @@map("classes")
}

model Subject {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  name        String
  code        String
  description String?
  department  String?
  isCore      Boolean  @default(true) @map("is_core")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSubjects ClassSubject[]
  grades      Grade[]

  @@unique([schoolId, code])
  @@map("subjects")
}

model ClassSubject {
  id              String   @id @default(uuid()) @db.Uuid
  classId         String   @map("class_id") @db.Uuid
  subjectId       String   @map("subject_id") @db.Uuid
  teacherId       String?  @map("teacher_id") @db.Uuid
  periodsPerWeek  Int      @default(3) @map("periods_per_week")
  createdAt       DateTime @default(now()) @map("created_at")

  class           Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject         Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher         Teacher? @relation(fields: [teacherId], references: [id])

  @@unique([classId, subjectId])
  @@map("class_subjects")
}

// -------------------------------------------------------------
// STAKEHOLDERS (STUDENTS, TEACHERS, PARENTS)
// -------------------------------------------------------------

model Student {
  id                  String    @id @default(uuid()) @db.Uuid
  schoolId            String    @map("school_id") @db.Uuid
  profileId           String    @unique @map("profile_id") @db.Uuid
  registrationNumber  String    @map("registration_number")
  classId             String?   @map("class_id") @db.Uuid
  parentId            String?   @map("parent_id") @db.Uuid
  dateOfBirth         DateTime? @map("date_of_birth")
  gender              Gender?
  admissionDate       DateTime  @default(now()) @map("admission_date")
  status              String    @default("active")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  school              School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  profile             Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  class               Class?    @relation(fields: [classId], references: [id])
  parent              Parent?   @relation(fields: [parentId], references: [id])
  attendanceRecords   AttendanceRecord[]
  invoices            BillingInvoice[]
  payments            BillingPayment[]
  grades              Grade[]
  reportCards         TermReportCard[]

  @@unique([schoolId, registrationNumber])
  @@index([schoolId, classId])
  @@map("students")
}

model Teacher {
  id              String    @id @default(uuid()) @db.Uuid
  schoolId        String    @map("school_id") @db.Uuid
  profileId       String    @unique @map("profile_id") @db.Uuid
  employeeId      String    @map("employee_id")
  qualification   String?
  specialization  String?
  joiningDate     DateTime  @default(now()) @map("joining_date")
  status          String    @default("active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  school          School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  profile         Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  assignedClasses Class[]   @relation("ClassTeacher")
  classSubjects   ClassSubject[]

  @@unique([schoolId, employeeId])
  @@map("teachers")
}

model Parent {
  id                String    @id @default(uuid()) @db.Uuid
  schoolId          String    @map("school_id") @db.Uuid
  profileId         String    @unique @map("profile_id") @db.Uuid
  occupation        String?
  emergencyContact  String?   @map("emergency_contact")
  relationship      String?   // Father, Mother, Guardian
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  school            School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  profile           Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  children          Student[]

  @@map("parents")
}

// -------------------------------------------------------------
// ATTENDANCE & REGISTERS
// -------------------------------------------------------------

model ClassRegister {
  id              String       @id @default(uuid()) @db.Uuid
  schoolId        String       @map("school_id") @db.Uuid
  classId         String       @map("class_id") @db.Uuid
  academicYearId  String       @map("academic_year_id") @db.Uuid
  date            DateTime     @db.Date
  totalPresent    Int          @default(0) @map("total_present")
  totalAbsent     Int          @default(0) @map("total_absent")
  totalLate       Int          @default(0) @map("total_late")
  recordedBy      String?      @map("recorded_by") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  school          School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class           Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYear    AcademicYear @relation(fields: [academicYearId], references: [id])
  records         AttendanceRecord[]

  @@unique([schoolId, classId, date])
  @@map("class_registers")
}

model AttendanceRecord {
  id          String           @id @default(uuid()) @db.Uuid
  registerId  String           @map("register_id") @db.Uuid
  studentId   String           @map("student_id") @db.Uuid
  status      AttendanceStatus @default(present)
  remarks     String?
  timeIn      String?          @map("time_in")
  createdAt   DateTime         @default(now()) @map("created_at")

  register    ClassRegister    @relation(fields: [registerId], references: [id], onDelete: Cascade)
  student     Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([registerId, studentId])
  @@map("attendance_records")
}

// -------------------------------------------------------------
// EXAMINATIONS & GRADING
// -------------------------------------------------------------

model Exam {
  id              String       @id @default(uuid()) @db.Uuid
  schoolId        String       @map("school_id") @db.Uuid
  academicYearId  String       @map("academic_year_id") @db.Uuid
  name            String
  examType        ExamType     @default(end_of_term) @map("exam_type")
  startDate       DateTime     @map("start_date")
  endDate         DateTime     @map("end_date")
  isPublished     Boolean      @default(false) @map("is_published")
  createdAt       DateTime     @default(now()) @map("created_at")

  school          School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear    AcademicYear @relation(fields: [academicYearId], references: [id])
  grades          Grade[]

  @@map("exams")
}

model Grade {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  examId      String   @map("exam_id") @db.Uuid
  studentId   String   @map("student_id") @db.Uuid
  subjectId   String   @map("subject_id") @db.Uuid
  classScore  Decimal? @map("class_score") @db.Decimal(5, 2)
  examScore   Decimal? @map("exam_score") @db.Decimal(5, 2)
  totalScore  Decimal  @map("total_score") @db.Decimal(5, 2)
  gradeLetter String?  @map("grade_letter")
  remarks     String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId, subjectId])
  @@map("grades")
}

model TermReportCard {
  id                String       @id @default(uuid()) @db.Uuid
  schoolId          String       @map("school_id") @db.Uuid
  academicYearId    String       @map("academic_year_id") @db.Uuid
  studentId         String       @map("student_id") @db.Uuid
  classId           String       @map("class_id") @db.Uuid
  totalScore        Decimal      @map("total_score") @db.Decimal(7, 2)
  averageScore      Decimal      @map("average_score") @db.Decimal(5, 2)
  position          Int?
  classSize         Int?         @map("class_size")
  attendanceCount   Int?         @map("attendance_count")
  conduct           String?
  teacherRemarks    String?      @map("teacher_remarks")
  principalRemarks  String?      @map("principal_remarks")
  isPublished       Boolean      @default(false) @map("is_published")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  school            School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear      AcademicYear @relation(fields: [academicYearId], references: [id])
  student           Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class             Class        @relation(fields: [classId], references: [id])

  @@unique([academicYearId, studentId])
  @@map("term_report_cards")
}

// -------------------------------------------------------------
// BILLING, INVOICING & PAYMENTS
// -------------------------------------------------------------

model FeeCategory {
  id            String   @id @default(uuid()) @db.Uuid
  schoolId      String   @map("school_id") @db.Uuid
  name          String   // Tuition, Examination, PTA, Uniform, Transport
  description   String?
  isCompulsory  Boolean  @default(true) @map("is_compulsory")
  createdAt     DateTime @default(now()) @map("created_at")

  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  feeStructures FeeStructure[]
  invoiceItems  BillingInvoiceLineItem[]

  @@unique([schoolId, name])
  @@map("fee_categories")
}

model FeeStructure {
  id              String       @id @default(uuid()) @db.Uuid
  schoolId        String       @map("school_id") @db.Uuid
  academicYearId  String       @map("academic_year_id") @db.Uuid
  classId         String       @map("class_id") @db.Uuid
  feeCategoryId   String       @map("fee_category_id") @db.Uuid
  amount          Decimal      @db.Decimal(12, 2)
  dueDate         DateTime?    @map("due_date")
  createdAt       DateTime     @default(now()) @map("created_at")

  school          School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear    AcademicYear @relation(fields: [academicYearId], references: [id])
  class           Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  feeCategory     FeeCategory  @relation(fields: [feeCategoryId], references: [id], onDelete: Cascade)

  @@unique([schoolId, academicYearId, classId, feeCategoryId])
  @@map("fee_structures")
}

model BillingInvoice {
  id              String         @id @default(uuid()) @db.Uuid
  schoolId        String         @map("school_id") @db.Uuid
  studentId       String         @map("student_id") @db.Uuid
  academicYearId  String         @map("academic_year_id") @db.Uuid
  invoiceNumber   String         @unique @map("invoice_number")
  subtotal        Decimal        @db.Decimal(12, 2)
  discount        Decimal        @default(0.00) @db.Decimal(12, 2)
  totalAmount     Decimal        @map("total_amount") @db.Decimal(12, 2)
  amountPaid      Decimal        @default(0.00) @map("amount_paid") @db.Decimal(12, 2)
  balanceDue      Decimal        @map("balance_due") @db.Decimal(12, 2)
  status          InvoiceStatus  @default(pending)
  dueDate         DateTime       @map("due_date")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  school          School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student         Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear    AcademicYear   @relation(fields: [academicYearId], references: [id])
  lineItems       BillingInvoiceLineItem[]
  payments        BillingPayment[]

  @@index([schoolId, status])
  @@index([studentId])
  @@map("billing_invoices")
}

model BillingInvoiceLineItem {
  id            String      @id @default(uuid()) @db.Uuid
  invoiceId     String      @map("invoice_id") @db.Uuid
  feeCategoryId String      @map("fee_category_id") @db.Uuid
  description   String
  unitAmount    Decimal     @map("unit_amount") @db.Decimal(12, 2)
  quantity      Int         @default(1)
  totalAmount   Decimal     @map("total_amount") @db.Decimal(12, 2)
  createdAt     DateTime    @default(now()) @map("created_at")

  invoice       BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeCategory   FeeCategory    @relation(fields: [feeCategoryId], references: [id])

  @@map("billing_invoice_line_items")
}

model BillingPayment {
  id            String        @id @default(uuid()) @db.Uuid
  schoolId      String        @map("school_id") @db.Uuid
  invoiceId     String        @map("invoice_id") @db.Uuid
  studentId     String        @map("student_id") @db.Uuid
  receiptNumber String        @unique @map("receipt_number")
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod @map("payment_method")
  reference     String?
  receivedBy    String?       @map("received_by") @db.Uuid
  notes         String?
  paidAt        DateTime      @default(now()) @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")

  school        School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoice       BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([studentId])
  @@map("billing_payments")
}

model PaymentGatewaySetting {
  id                  String   @id @default(uuid()) @db.Uuid
  schoolId            String   @map("school_id") @db.Uuid
  provider            String   // stripe, paystack
  publicKey           String   @map("public_key")
  secretKeyEncrypted  String   @map("secret_key_encrypted")
  webhookSecret       String?  @map("webhook_secret")
  isEnabled           Boolean  @default(false) @map("is_enabled")
  isLive              Boolean  @default(false) @map("is_live")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  school              School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, provider])
  @@map("payment_gateway_settings")
}

// -------------------------------------------------------------
// OPERATIONS, AUDIT & NOTIFICATIONS
// -------------------------------------------------------------

model Announcement {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  title          String
  content        String
  targetAudience String   @default("all") @map("target_audience") // all, teachers, parents, students
  priority       String   @default("normal")
  publishedAt    DateTime @default(now()) @map("published_at")
  authorId       String?  @map("author_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("announcements")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String?  @map("school_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  oldData   Json?    @map("old_data")
  newData   Json?    @map("new_data")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  school    School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@map("audit_logs")
}
