# Supabase Configuration (web app auth / existing features)
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# EduManage Desktop cloud sync → Neon Postgres (optional; currently unused)
# Prefer the pooled connection string. Do not commit real credentials.
# NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
ELECTRON_SYNC_INTERVAL_MS=60000
# ELECTRON_FORCE_OFFLINE=1

# OpenAI Realtime Voice Configuration
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
OPENAI_VOICE=alloy

# Twilio Programmable Voice Telephony
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Voice Gateway & Escalation
VOICE_SUPPORT_NUMBER=
VOICE_MAX_CALL_DURATION=600
VOICE_RECORDING_ENABLED=true
VOICE_GATEWAY_PORT=8088
