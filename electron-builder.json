{
  "appId": "com.edumanage.desktop",
  "productName": "EduManage Desktop",
  "copyright": "Copyright © EduManage",
  "directories": {
    "output": "release",
    "buildResources": "electron/assets"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json",
    "node_modules/**/*",
    "!node_modules/**/{CHANGELOG.md,README.md,README,readme.md,readme,*.map}",
    "!node_modules/**/{test,__tests__,tests,example,examples,.bin}",
    "!node_modules/.cache/**/*",
    "!**/{.git,.github,.vscode,.idea,.DS_Store,*.log}"
  ],
  "asarUnpack": [
    "**/*.node",
    "node_modules/better-sqlite3/**/*",
    "node_modules/bindings/**/*",
    "node_modules/file-uri-to-path/**/*",
    "node_modules/serialport/**/*",
    "node_modules/@serialport/**/*",
    "node_modules/usb/**/*"
  ],
  "extraResources": [],
  "win": {
    "target": ["nsis"],
    "icon": "electron/assets/icon.png"
  },
  "mac": {
    "target": ["dmg"],
    "icon": "electron/assets/icon.png",
    "category": "public.app-category.education"
  },
  "linux": {
    "target": ["AppImage"],
    "icon": "electron/assets/icon.png",
    "category": "Education"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  },
  "publish": {
    "provider": "generic",
    "url": "https://updates.example.com/edumanage-desktop/",
    "channel": "latest"
  }
}
